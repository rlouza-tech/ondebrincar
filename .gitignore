# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# generated pipeline outputs
/data/output/*
!/data/output/.gitkeep
# imagens locais nomeadas por slug (não versionar binários)
/data/input/imagens/*
!/data/input/imagens/.gitkeep
# snapshots de scrape — sobrescritos por completo a cada rodada do pipeline,
# não têm valor de histórico (pipeline-runs.json continua versionado, esse é log real)
/data/input/planilha-origem.csv
/data/input/sympla-raw.json
/data/input/sympla-raw-pre-filter.json
/data/input/sympla-raw-enriquecido.json
/data/input/sympla-descartados.json
/data/input/uhuu-raw.csv
/data/input/ecovilla-raw.csv
